{
  "name": "@chat-example/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.907.0",
    "@aws-sdk/lib-dynamodb": "^3.907.0",
    "bullmq": "^5.61.0",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.21.2",
    "ioredis": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
