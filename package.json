{
  "name": "chat-example",
  "private": true,
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:frontend": "pnpm --filter @chat-example/frontend dev",
    "dev:backend": "pnpm --filter @chat-example/backend dev",
    "dev:worker": "pnpm --filter @chat-example/backend dev:worker",
    "build": "pnpm -r run build",
    "test": "pnpm --filter @chat-example/backend test",
    "lint": "pnpm --filter @chat-example/frontend lint",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  }
}
